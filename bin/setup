#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

def fail_setup!(message)
  warn "\nSetup failed: #{message}"
  exit 1
end

FileUtils.chdir APP_ROOT do
  puts "== Checking Ruby =="
  expected = File.read(".ruby-version").strip
  actual = RUBY_VERSION
  unless actual == expected
    fail_setup!("Ruby #{expected} is required (see .ruby-version). This shell has #{actual}. Switch with rbenv, rvm, asdf, or whatever you use, then rerun bin/setup.")
  end
  puts "Ruby #{actual}"

  puts "\n== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  puts "\n== Checking PostgreSQL =="
  unless system("pg_isready --quiet")
    fail_setup!("PostgreSQL is not running. Start it and rerun bin/setup.")
  end
  puts "PostgreSQL is accepting connections"

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  puts "\n== Verifying Rails can boot =="
  system! 'bin/rails runner "puts %(ok: #{Rails.version} on Ruby #{RUBY_VERSION})"'

  puts "\nSetup complete. Run bin/rails s to start the API, or bundle exec rspec to run tests."
end
